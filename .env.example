# Application URL used for regression testing
APP_URL=https://shopify-onboarding-three.vercel.app

# Application URL for baseline UI design mainly used for baseline screenshot
# generation. Ideally should be a running dev server from the baseline UI design
# app version in baseline/ui-design-app git submodule.
BASELINE_UI_DESIGN_APP_URL=http://localhost:3000

# Screenshot Generation Mode
# Note: Set via npm scripts, not directly in .env (see scripts in package.json)
# GENERATE_BASELINE_SCREENSHOTS_ONLY

# OpenRouter
OPENROUTER_API_KEY=

# Axiom (optional, for telemetry/logging)
AXIOM_DATASET=
AXIOM_TOKEN=

# Redis (optional, for caching Passmark AI calls)
REDIS_URL=
